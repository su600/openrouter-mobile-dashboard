<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/news_item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/news_new_badge"
        android:layout_width="44dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_topup_background"
        android:gravity="center"
        android:text="@string/news_new_badge"
        android:textColor="#0f1117"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/news_logo"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/news_logo_background"
        android:contentDescription="@string/news_logo_description"
        android:padding="2dp"
        android:scaleType="centerInside"
        android:src="@drawable/news_openai" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/news_vendor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/news_vendor_placeholder"
                android:textColor="#e6e8ec"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="@string/news_announce"
                android:textColor="#8b8fa3"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/news_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/news_model_placeholder"
                android:textColor="#4ade80"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/news_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/news_date_placeholder"
            android:textColor="#6b7085"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
